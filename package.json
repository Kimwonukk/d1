{
  "name": "static",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "concurrently --raw \"pnpm watch:tokens\" \"pnpm watch:images\" \"pnpm generate:pages --watch\" \"astro dev\"",
    "watch:images": "tsx tasks/optimize-images.ts --watch",
    "optimize:images": "tsx tasks/optimize-images.ts",
    "build": "pnpm optimize:images && pnpm tsx tasks/generate-pages.ts && BUILD_MODE=unified astro build && pnpm buildAfter && pnpm format:dist",
    "standalone": "pnpm optimize:images && BUILD_REPO=standalone pnpm tsx tasks/generate-pages.ts && BUILD_MODE=unified astro build && tsx tasks/standalone.ts && pnpm buildAfter && pnpm format:standalone",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:dist": "prettier --write --ignore-path .prettierignore 'dist/**/*.{html,css,js}'",
    "format:standalone": "prettier --write --ignore-path .prettierignore 'standalone/**/*.{html,css,js}'",
    "generate:pages": "pnpm tsx tasks/generate-pages.ts",
    "tokens": "cross-env NODE_ENV=production pnpm tsx tasks/tokenforFigma.ts",
    "watch:tokens": "pnpm tsx tasks/tokenforFigma.ts",
    "buildAfter": "pnpm tsx tasks/taskForbuildAfter.ts",
    "astro": "astro",
    "lint": "eslint . && stylelint \"**/*.{scss,astro}\"",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{scss,astro}\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "astro": "^5.16.7",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@astrojs/mdx": "^4.3.13",
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "chokidar": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-plugin-astro": "^1.5.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "glob": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "minimatch": "^10.1.1",
    "prettier": "^3.7.4",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.97.2",
    "stylelint": "^17.0.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.54.0"
  },
  "browserslist": [
    "Chrome >= 80",
    "Edge >= 80",
    "Safari >= 13.1",
    "iOS >= 13.4",
    "not dead"
  ]
}
