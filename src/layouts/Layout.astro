---
import Header from '@layout/Header.astro';
import Footer from '@layout/Footer.astro';
import Container from '@structure/Container.astro';
import type { Meta } from '@scripts/type/meta';
import Base from './Base.astro';

interface Props {
  pageMeta?: Meta;
}

const { pageMeta } = Astro.props;

// title 결정
const pageTitle = pageMeta?.title || 'Static';
---

<Base>
  <title>{pageTitle} - Static</title>

  <Fragment slot="head"></Fragment>

  <Container slot="body">
    <Header />
    <main class="main">
      <h1 class="page-title">{pageTitle}</h1>
      <div class="contents">
        <slot />
      </div>
    </main>
    <Footer />
  </Container>
</Base>

<style is:global lang="scss">
  @use '../styles/mixins' as *;

  .main {
    padding: 60px 0 100px;
    min-height: calc(
      100vh - 64px - 140px
    ); // viewport - header - footer approximate

    display: flex;
    flex-direction: column;
    gap: 40px;

    .page-title {
      @include typo-xl-bold;

      color: var(--color-black-900);
      margin: 0;
    }

    .contents {
      flex: 1;
    }
  }
</style>
