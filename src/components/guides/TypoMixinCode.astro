---
interface Props {
  name: string;
  value: Array<{ name: string; value: string | object }>;
}
const toTokenName = (name: string) => {
  let temp = String(name);
  if (!temp.includes('{')) {
    return temp;
  }
  temp = temp.replace('{', '').replace('}', '');
  temp = temp.split('.').join('-');
  return `--${temp}`;
};
const { name, value } = Astro.props; // TypeScript 권장
---

<section>
  <h3>{name}</h3>
  <ul class="token-code">
    {
      value.map((value) => (
        <li>
          <div class="token-code-list">
            <p
              class={`typo-${name}-${value.name}`}
            >{`typo-${name}-${value.name}`}</p>
            <button type="button" class="token-code-content">
              <div class="codes">
                <span>
                  <span class="css-token">{`@include typo-${name}-${value.name};`}</span>
                  <i class="copy">복사하기</i>
                </span>
                <ul>
                  {Object.entries(value.value).map(([key, value]) => (
                    <li>
                      {key}: {toTokenName(value)}
                    </li>
                  ))}
                </ul>
              </div>
            </button>
          </div>
        </li>
      ))
    }
  </ul>
</section>
