---
import Container from '@structure/Container.astro';
---

<footer class="footer">
  <Container>
    <div class="footer-content">
      <p class="footer-text">© 2026 Static. All rights reserved.</p>
    </div>
  </Container>
</footer>

<style is:global lang="scss">
  @use '../../styles/mixins' as *;
  .footer {
    background-color: var(--color-white-100);
    border-top: 1px solid var(--color-black-50);
    padding: 40px 0;
    margin-top: auto;

    &-content {
      display: flex;
      justify-content: center;
    }

    &-text {
      @include typo-sm-regular;
      color: var(--color-black-300);
    }
  }
</style>
