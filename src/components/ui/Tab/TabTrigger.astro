---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button' | 'div'> {
  as?: 'button' | 'div';
  defaultActive?: boolean;
}
const {
  as = 'button',
  defaultActive = false,
  class: className,
  ...rest
} = Astro.props;
const classLists = ['tab-trigger', defaultActive && 'active', className].filter(
  Boolean
);
const Tag = as;
const _type = as === 'button' ? 'button' : undefined;
---

<Tag type={_type} class={classLists.join(' ')} {...rest} data-tab-trigger="">
  <slot />
</Tag>
