---
interface Props {
  title?: string;
  description?: string;
  href?: string;
}

const { title, description, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag class="card" href={href}>
  {title && <h3 class="card-title">{title}</h3>}
  {description && <p class="card-content">{description}</p>}
  <slot />
</Tag>

<style is:global lang="scss"></style>
